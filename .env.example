# Example environment variables for docker-compose
# Copy this file to .env and update with strong passwords before running docker-compose

# SECURITY WARNING: Never commit the actual .env file to version control!
# Generate strong passwords using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# MySQL Root Password (use a strong, random password)
MYSQL_ROOT_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# MySQL Database Name
MYSQL_DATABASE=prestamax

# MySQL User
MYSQL_USER=prestamaxuser

# MySQL User Password (use a strong, random password different from root)
MYSQL_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
