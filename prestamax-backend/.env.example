# Example .env for prestamax-backend
# Copy to .env and update values before running the backend

DB_HOST=127.0.0.1
DB_USER=prestamaxuser
DB_PASS=prestamaxpass
DB_NAME=prestamax
DB_PORT=3306

# Optional: change backend port
# PORT=3001

# JWT secret for signing tokens (change in production)
JWT_SECRET=ChangeMeToAStrongSecret
