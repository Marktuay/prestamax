# Example .env for prestamax-backend
# SECURITY: Copy to .env and update ALL values before running the backend
# NEVER commit the actual .env file to version control!

# Database Configuration
DB_HOST=127.0.0.1
DB_USER=prestamaxuser
# SECURITY: Change to a strong, random password (32+ characters recommended)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DB_PASS=CHANGE_ME_TO_A_STRONG_PASSWORD
DB_NAME=prestamax
DB_PORT=3306

# Backend Server Configuration
# PORT=3001

# JWT Configuration
# SECURITY CRITICAL: Change to a strong, random secret (64+ characters recommended)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET_AT_LEAST_64_CHARACTERS

# CORS Configuration (Production)
# Comma-separated list of allowed origins
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Environment (development, production)
# NODE_ENV=production

